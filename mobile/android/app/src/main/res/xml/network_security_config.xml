<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, trusting the system certificate authorities (not
     user-installed ones, so a proxy certificate added on the phone can't read
     the traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
