PORT=8001
API_PREFIX=/api
NODE_ENV=development
# Database: either one connection link (a hosted server; the built-in
# embedded Postgres is then not started; sslmode=require for SSL)...
# DATABASE_URL=postgresql://user:password@host:5432/bank_app?sslmode=require
# ...or the separate settings (embedded Postgres unless PG_EMBEDDED=false).
# PG_DATABASE, when set, overrides the link's database name.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=bank_app
JWT_SECRET=change-me-to-a-random-string-of-24-or-more-characters
JWT_EXPIRES_IN=8h
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
EMPLOYEE_DEFAULT_PASSWORD=
UPLOAD_MAX_SIZE_BYTES=10485760
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# SMS (Flowit). Backend-only: never put these in the frontend.
# Off by default; with SMS_ENABLED=false every requested SMS is logged as
# SKIPPED (SMS_DISABLED) and nothing is sent.
SMS_ENABLED=false
FLOWIT_BASE_URL=https://sms.flowitof.com
# Flowit dashboard -> Dev API.
FLOWIT_API_KEY=
# DLT-approved sender ID / header, letters or digits (a template row may set its own).
FLOWIT_SENDER_ID=
# Shared secret Flowit sends with each delivery report, in the custom header
# named below (configure both in the Flowit webhook settings).
FLOWIT_WEBHOOK_SECRET=
FLOWIT_WEBHOOK_HEADER=x-webhook-secret
FLOWIT_TIMEOUT_MS=10000
# Optional longest value per {#var#}, once Flowit/DLT confirm one. Empty = no
# limit. A longer value makes that SMS FAILED (VARIABLE_TOO_LONG); never cut.
SMS_MAX_VARIABLE_LENGTH=
# Optional key for the mobile-number hash in sms_messages (defaults to JWT_SECRET).
SMS_HASH_SECRET=

# TEMPORARY Flowit connectivity test only (Settings -> SMS -> Send Test OTP).
# Sender ID and DLT message ID of an OTP template already approved on DLT
# (it may belong to another client); never a Banking Raipur template, never
# sent to members. The test number receives the one test SMS. Leave all
# empty when not testing. Never commit real values.
FLOWIT_TEST_SENDER_ID=
FLOWIT_TEST_MESSAGE_ID=
FLOWIT_TEST_MOBILE=
# The {#var#} value sent; defaults to 180589 outside production.
FLOWIT_TEST_OTP=
# The test route is refused when NODE_ENV=production unless this is true.
FLOWIT_TEST_ALLOW_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Google Drive (Settings -> Google Drive)
# Daily database backups, and optionally uploaded files
# (Settings -> Storage Providers -> Google Drive).
#
# Setup in Google Cloud Console:
#   1. Enable the "Google Drive API".
#   2. Credentials -> Create OAuth client ID -> type "Web application".
#   3. Add GOOGLE_OAUTH_REDIRECT_URI under "Authorized redirect URIs".
#   4. OAuth consent screen -> publish the app ("In production"); in "Testing"
#      Google expires the token after 7 days and backups stop.
#
# Then connect in ONE of two ways:
#   a) Settings -> Google Drive -> "Connect Google Drive" and sign in, or
#   b) set GOOGLE_OAUTH_REFRESH_TOKEN below and restart the backend.
# ---------------------------------------------------------------------------

# Required: the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required: encrypts the stored Google token. 64 hex characters, generate once
# with `openssl rand -hex 32` and never change it (changing it means reconnecting).
SETTINGS_ENCRYPTION_KEY=

# Sign-in flow (a) only. Must match the redirect URI in the OAuth client exactly.
# Default: http://localhost:${PORT}${API_PREFIX}/google-drive/oauth/callback
# Production: https://<api-domain>/api/google-drive/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Where the browser returns after sign-in (first entry if several, comma
# separated). Also the CORS origin list when CORS_ORIGINS is not set.
FRONTEND_URL=http://localhost:5173

# Optional (b): a refresh token issued for the client above. Connects Drive on
# first use without the sign-in; applied once per token value, so Disconnect in
# Settings is not undone by a restart. Needs the "drive.file" or "drive" scope.
# An access token is not needed: it is refreshed automatically.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional: main Drive folder holding the backup and uploads folders (folder id,
# or its link https://drive.google.com/drive/folders/<id>). Empty = My Drive root.
# A folder you created yourself is only visible with the full "drive" scope.
GDRIVE_PARENT_FOLDER_ID=
# Optional: folder names inside it (reused if a folder with the name exists).
GDRIVE_BACKUP_FOLDER_NAME=Banking Raipur – DB Backups
GDRIVE_UPLOADS_FOLDER_NAME=Banking Raipur – Uploads

# Optional: backups kept, oldest deleted first (default 7, max 100).
GDRIVE_BACKUP_KEEP=7
# Optional: hour of the daily backup in India time, 0-23 (default 2; -1 = manual only).
GDRIVE_BACKUP_HOUR_IST=2
# Optional: pg_dump binary; its major version must match the PostgreSQL server
# (e.g. /usr/lib/postgresql/18/bin/pg_dump for PostgreSQL 18).
PG_DUMP_PATH=pg_dump

# Legacy SQL Server source for tools/legacy-migration (mssql-legacy docker container)
LEGACY_SQL_SERVER=
LEGACY_SQL_PORT=1433
LEGACY_SQL_USER=
LEGACY_SQL_PASSWORD=
