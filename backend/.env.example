PORT=8001
API_PREFIX=/api
NODE_ENV=development
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=bank_app
JWT_SECRET=change-me-to-a-random-string-of-24-or-more-characters
JWT_EXPIRES_IN=8h
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
EMPLOYEE_DEFAULT_PASSWORD=
UPLOAD_MAX_SIZE_BYTES=10485760
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# SMS (Flowit). Backend-only: never put these in the frontend.
# Off by default; with SMS_ENABLED=false every requested SMS is logged as
# SKIPPED (SMS_DISABLED) and nothing is sent.
SMS_ENABLED=false
FLOWIT_BASE_URL=https://sms.flowitof.com
# Flowit dashboard -> Dev API.
FLOWIT_API_KEY=
# DLT-approved sender ID / header, letters or digits (a template row may set its own).
FLOWIT_SENDER_ID=
# Shared secret Flowit sends with each delivery report, in the custom header
# named below (configure both in the Flowit webhook settings).
FLOWIT_WEBHOOK_SECRET=
FLOWIT_WEBHOOK_HEADER=x-webhook-secret
FLOWIT_TIMEOUT_MS=10000
# Optional longest value per {#var#}, once Flowit/DLT confirm one. Empty = no
# limit. A longer value makes that SMS FAILED (VARIABLE_TOO_LONG); never cut.
SMS_MAX_VARIABLE_LENGTH=
# Optional key for the mobile-number hash in sms_messages (defaults to JWT_SECRET).
SMS_HASH_SECRET=

# TEMPORARY Flowit connectivity test only (Settings -> SMS -> Send Test OTP).
# Sender ID and DLT message ID of an OTP template already approved on DLT
# (it may belong to another client); never a Banking Raipur template, never
# sent to members. The test number receives the one test SMS. Leave all
# empty when not testing. Never commit real values.
FLOWIT_TEST_SENDER_ID=
FLOWIT_TEST_MESSAGE_ID=
FLOWIT_TEST_MOBILE=
# The {#var#} value sent; defaults to 180589 outside production.
FLOWIT_TEST_OTP=
# The test route is refused when NODE_ENV=production unless this is true.
FLOWIT_TEST_ALLOW_IN_PRODUCTION=false

# Legacy SQL Server source for tools/legacy-migration (mssql-legacy docker container)
LEGACY_SQL_SERVER=
LEGACY_SQL_PORT=1433
LEGACY_SQL_USER=
LEGACY_SQL_PASSWORD=
